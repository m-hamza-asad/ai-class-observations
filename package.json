{
  "name": "lesson-observation",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w web",
    "dev:worker": "npm run dev -w worker",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "bootstrap-admin": "node --env-file-if-exists=apps/worker/.env scripts/bootstrap-admin.mjs",
    "check-rls": "node --env-file-if-exists=apps/worker/.env scripts/check-rls.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "ffmpeg-static@5.3.0": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.27.7": true
  },
  "devDependencies": {
    "supabase": "^2.118.0"
  }
}
