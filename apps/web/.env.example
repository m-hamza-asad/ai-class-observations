NEXT_PUBLIC_WORKER_URL=
# Local-dev only: target for the /worker/* proxy
WORKER_INTERNAL_URL=http://localhost:4000

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server-only (admin invites); never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
