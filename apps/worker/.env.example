# SUPABASE_SERVICE_ROLE_KEY=
# DATABASE_URL=            # Supabase Postgres connection string (used by pg-boss job queue)
# GROQ_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
