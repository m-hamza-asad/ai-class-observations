PORT=4000
# Shared secret for the /lab test endpoints (leave empty only for local dev)
LAB_TOKEN=
# Comma-separated allowed browser origins, e.g. https://your-app.vercel.app (empty = allow all, dev only)
CORS_ORIGINS=
# Where chunks / normalized files are staged. On Railway, mount a volume at /data.
DATA_DIR=data
LOG_LEVEL=info

# --- added from Day 2 onward ---
