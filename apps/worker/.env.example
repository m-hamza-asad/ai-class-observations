PORT=4000
# Shared secret for the /lab test endpoints (leave empty only for local dev)
LAB_TOKEN=
LAB_RETENTION_HOURS=24
# Comma-separated allowed browser origins, e.g. https://your-app.vercel.app (empty = allow all, dev only)
CORS_ORIGINS=
# Where chunks / normalized files are staged. On Railway, mount a volume at /data.
DATA_DIR=data
LOG_LEVEL=info

# Pipeline (leave empty to run lab-only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase Postgres connection string, Session pooler (pg-boss job queue)
DATABASE_URL=

# --- added in later build steps ---
# GROQ_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
